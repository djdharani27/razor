# Razorpay test-mode keys — get these from https://dashboard.razorpay.com (Test Mode).
# Copy this file to .env.local and fill in real values. Never commit .env.local.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Hard cap on a single checkout total, in paise (default ₹5000). The checkout
# API rejects orders above this and returns a structured JSON error.
SPEND_CAP_PAISE=500000
