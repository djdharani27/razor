# Razorpay test-mode keys — get these from https://dashboard.razorpay.com (Test Mode).
# NEVER commit real keys. Copy this file to .env.local and fill in your values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Hard cap on a single checkout total, in paise (default ₹5000).
SPEND_CAP_PAISE=500000

# --- Gemini AI Agent ---
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name — change to switch models (e.g. gemini-2.0-flash, gemini-pro, gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# --- UPI Reserve Pay ---
# Optional: the block (in paise) reserved when a customer authorises UPI Reserve
# Pay for the first time. Defaults to ₹5,000 and is automatically bumped up to
# the cart total when higher. Hard ceiling is ₹10,000 (1,000,000 paise) and the
# mandate expires 90 days after authorisation — both enforced by Razorpay.
# MANDATE_BLOCK_PAISE=500000
