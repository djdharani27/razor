# Razorpay test-mode keys — get these from https://dashboard.razorpay.com (Test Mode).
# NEVER commit real keys. Copy this file to .env.local and fill in your values.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Hard cap on a single checkout total, in paise (default ₹5000).
SPEND_CAP_PAISE=500000

# --- Gemini AI Agent ---
# Get your API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model name — change to switch models (e.g. gemini-2.0-flash, gemini-pro, gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# --- SBMD Charge-Only Flow ---
# These IDs come from an already-authorized UPI SBMD mandate.
# The agent uses them to create charge orders and recurring payments
# WITHOUT creating new customers or mandates.
RAZORPAY_CUSTOMER_ID=
RAZORPAY_TOKEN_ID=
RAZORPAY_CUSTOMER_EMAIL=
RAZORPAY_CUSTOMER_CONTACT=
